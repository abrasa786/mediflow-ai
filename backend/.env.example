# ── Required ──
GROQ_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key (same as NEXT_PUBLIC_SUPABASE_ANON_KEY) — used to verify user logins
SUPABASE_ANON_KEY=

# ── Recommended: enables the background worker ──
# Repeat WhatsApp buzz (60s), missed calls (90s), emergency-contact updates (2 min),
# appointment reminders (30 min before). Supabase → Project Settings → API → service_role.
# NEVER put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp + missed-call alerts (Twilio). Without these, alerts run in "test mode". ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_VOICE_FROM=

# ── Links used inside WhatsApp messages ──
APP_URL=https://mediflowai.in
CLINIC_PORTAL_URL=https://clinic.mediflowai.in
